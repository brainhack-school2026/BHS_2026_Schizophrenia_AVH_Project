#!/bin/bash

#SBATCH --job-name=fmriprep_skip_nofs
#SBATCH --output=<INSERT_PROJECT_DIRECTORY>/logs/%x_%A_%a.out
#SBATCH --error=<INSERT_PROJECT_DIRECTORY>/logs/%x_%A_%a.err
#SBATCH --account=teach
#SBATCH --partition=compute
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --time=04:00:00
#SBATCH --array=0-26%12

set -euo pipefail

# ------------------------------------------------------------
# Script: run_fmriprep_skipstrip_nofs_array.sh
# Purpose:
#   Preprocess a 27-participant subset of OpenNeuro ds004302 using
#   fMRIPrep on a SLURM cluster.
#
# Notes:
#   - This script runs as a SLURM array job.
#   - It runs 27 total tasks, with a maximum of 12 concurrent jobs.
#   - T1w skull stripping is skipped because ds004302 anatomical images
#     were already skull stripped.
#   - FreeSurfer recon-all is disabled because surface reconstruction was
#     not required for the MNI-space seed-to-voxel functional connectivity
#     analysis.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Subject list
# ------------------------------------------------------------
# HC:    01 02 03 04 05 06 07 08 09
# AVH−:  26 27 28 29 30 32 33 34 36
# AVH+:  55 56 57 58 59 60 61 62 63

SUBJECTS=(01 02 03 04 05 06 07 08 09 26 27 28 29 30 32 33 34 36 55 56 57 58 59 60 61 62 63)
SUBJECT=${SUBJECTS[$SLURM_ARRAY_TASK_ID]}

# ------------------------------------------------------------
# User-specific paths
# ------------------------------------------------------------
# Replace these placeholder paths with your own cluster/project paths.

export PROJECT_DIR="<INSERT_PROJECT_DIRECTORY>"
export BIDS_DIR="<INSERT_BIDS_DATASET_DIRECTORY>"

export FMRIPREP_HOME="<INSERT_TEMPLATEFLOW_DIRECTORY>"
export TEMPLATEFLOW_HOME_HOST="${FMRIPREP_HOME}/.cache/templateflow"

export SING_CONTAINER="<INSERT_PATH_TO_FMRIPREP_CONTAINER>/fmriprep-25.2.4.simg"
export FS_LICENSE="<INSERT_PATH_TO_FREESURFER_LICENSE>/fs_license.txt"

export OUTPUT_DIR="${PROJECT_DIR}/derivatives/ds004302/fmriprep_skipstrip_nofs/25.2.4"
export LOGS_DIR="${PROJECT_DIR}/logs"

mkdir -vp "${OUTPUT_DIR}" "${LOGS_DIR}" "${FMRIPREP_HOME}"

# Use temporary scratch space assigned by SLURM.
export WORK_DIR="${SLURM_TMPDIR}/fmriprep_work_${SUBJECT}"
mkdir -vp "${WORK_DIR}"

# ------------------------------------------------------------
# Basic checks
# ------------------------------------------------------------

if [[ ! -d "${BIDS_DIR}/sub-${SUBJECT}" ]]; then
  echo "ERROR: Missing participant folder: ${BIDS_DIR}/sub-${SUBJECT}" >&2
  exit 1
fi

if [[ ! -f "${SING_CONTAINER}" ]]; then
  echo "ERROR: fMRIPrep container not found: ${SING_CONTAINER}" >&2
  exit 1
fi

if [[ ! -f "${FS_LICENSE}" ]]; then
  echo "ERROR: FreeSurfer license not found: ${FS_LICENSE}" >&2
  exit 1
fi

if [[ ! -d "${TEMPLATEFLOW_HOME_HOST}" ]]; then
  echo "ERROR: TemplateFlow cache missing at ${TEMPLATEFLOW_HOME_HOST}" >&2
  exit 1
fi

# ------------------------------------------------------------
# Load Apptainer
# ------------------------------------------------------------

module load apptainer/1.3.5

export APPTAINERENV_TEMPLATEFLOW_HOME=/home/fmriprep/.cache/templateflow
export APPTAINERENV_TEMPLATEFLOW_OFFLINE=1

echo "Starting subject ${SUBJECT} at $(date)"

# ------------------------------------------------------------
# Run fMRIPrep
# ------------------------------------------------------------

apptainer run --cleanenv \
  -B "${FMRIPREP_HOME}:/home/fmriprep" --home /home/fmriprep \
  -B "${TEMPLATEFLOW_HOME_HOST}:/home/fmriprep/.cache/templateflow:ro" \
  -B "${BIDS_DIR}:/bids:ro" \
  -B "${OUTPUT_DIR}:/derived" \
  -B "${WORK_DIR}:/work" \
  -B "${FS_LICENSE}:/li" \
  "${SING_CONTAINER}" \
  /bids /derived participant \
  --participant-label "${SUBJECT}" \
  -w /work \
  --skip-bids-validation \
  --nthreads 8 \
  --omp-nthreads 4 \
  --mem-mb 30000 \
  --output-spaces MNI152NLin2009cAsym:res-2 \
  --fs-license-file /li \
  --ignore slicetiming \
  --skull-strip-t1w skip \
  --fs-no-reconall \
  --notrack

echo "Done subject ${SUBJECT} at $(date). Outputs: ${OUTPUT_DIR}"
